# inbox-janitor reads these from the environment (or from --env-file; real variables win).
# Nothing secret goes in janitor.toml.

# Where the ledger, state, rules and the fingerprint key live (default ~/.inbox-janitor).
INBOX_JANITOR_STATE=/var/lib/inbox-janitor

# Gmail OAuth "authorized user" JSON: {"client_id": ..., "client_secret": ...,
# "refresh_token": ...}. Scope: https://www.googleapis.com/auth/gmail.modify
INBOX_JANITOR_GMAIL_TOKEN=/etc/inbox-janitor/gmail-token.json

# Only when [classifier] kind is "llm" or "rules+llm". The endpoint receives message content
# and the key, which is why both live here and not in janitor.toml. https:// only, or plain
# http:// to a model on this machine (localhost, 127.0.0.1, ::1).
INBOX_JANITOR_LLM_URL=https://api.openai.com/v1
INBOX_JANITOR_LLM_KEY=
